    <style name="Widget.FocusZone.DangerButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/danger_red</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="android:textColor">@color/danger_red</item>
        <item name="iconTint">@color/danger_red</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="Widget.FocusZone.IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/focus_orange</item>
    </style>
    <style name="Widget.FocusZone.MetricCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="strokeColor">@color/surface_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_height">112dp</item>
    </style>
