<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/TextAppearance.FocusZone.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/statistics" />

        <TextView
            style="@style/TextAppearance.FocusZone.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/weekly_overview" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusZone.Card"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp">

            <com.github.mikephil.charting.charts.HorizontalBarChart
                android:id="@+id/weeklyMinutesChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FocusZone.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/monthly_heatmap" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusZone.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.focuszone.ui.stats.HeatmapView
                android:id="@+id/monthHeatmap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusZone.StatGridCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1">
                <LinearLayout
                    style="@style/Widget.FocusZone.StatGridContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/bestDayValue"
                        style="@style/TextAppearance.FocusZone.CardValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-" />
                    <TextView
                        android:id="@+id/bestDaySubtitle"
                        style="@style/TextAppearance.FocusZone.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/best_day" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusZone.StatGridCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1">
                <LinearLayout
                    style="@style/Widget.FocusZone.StatGridContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/averageValue"
                        style="@style/TextAppearance.FocusZone.CardValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0.0" />
                    <TextView
                        style="@style/TextAppearance.FocusZone.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/average_sessions_per_day" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusZone.StatGridCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1">
                <LinearLayout
                    style="@style/Widget.FocusZone.StatGridContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/cyclesValue"
                        style="@style/TextAppearance.FocusZone.CardValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0" />
                    <TextView
                        style="@style/TextAppearance.FocusZone.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/total_cycles_completed" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusZone.StatGridCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1">
                <LinearLayout
                    style="@style/Widget.FocusZone.StatGridContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/hourValue"
                        style="@style/TextAppearance.FocusZone.CardValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-" />
                    <TextView
                        style="@style/TextAppearance.FocusZone.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/most_productive_hour" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <TextView
            style="@style/TextAppearance.FocusZone.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/focus_vs_break" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusZone.Card"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/focusBreakPie"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
